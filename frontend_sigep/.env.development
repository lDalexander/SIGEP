# Configuración del servidor de desarrollo (react-scripts start). NO afecta a
# producción: nginx sirve build/ en el puerto 3000.
#
# Por qué HOST está fijado a la IP del servidor:
#   La clave "proxy" de package.json activa el host check de CRA (protección contra
#   DNS rebinding). Ese check necesita resolver la URL de LAN, y con el HOST por
#   defecto (0.0.0.0) no puede: allowedHosts queda vacío y el dev server se niega a
#   arrancar con "options.allowedHosts[0] should be a non-empty string".
#   Fijando HOST a la IP real, el check funciona y se conserva la protección.
HOST=150.36.200.252
PORT=3001

# El dashboard llama a /api con ruta relativa; la clave "proxy" de package.json
# redirige esas peticiones a 127.0.0.1:8000 durante el desarrollo.

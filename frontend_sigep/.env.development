# Configuración del servidor de desarrollo (react-scripts start). NO afecta a
# producción: nginx sirve build/ en el puerto 3000.
#
# El puerto 3000 lo ocupa nginx, así que el dev server usa el 3001.
PORT=3001

# HOST se deja en su valor por defecto (0.0.0.0) para escuchar en todas las
# interfaces y poder abrir el dashboard desde la IP del servidor.
#
# El reenvío de /api al backend está en src/setupProxy.js, no en la clave "proxy"
# de package.json: ese atajo activa un host check que CRA no puede satisfacer
# cuando la IP del servidor es pública. El detalle está comentado en ese archivo.

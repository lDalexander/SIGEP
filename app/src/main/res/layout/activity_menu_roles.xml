<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F0F0F0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIGEP"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccione un perfil:"
        android:textSize="18sp"
        android:textColor="#555555"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnRolOperario"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="👷 OPERARIO"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnRolInsumista"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="📦 GESTIÓN DE INSUMOS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnRolSupervisor"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="👔 SUPERVISOR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#3F51B5"
        android:layout_marginBottom="1dp"/> <com.google.android.material.button.MaterialButton
    android:id="@+id/btnAdminAccess"
    style="@style/Widget.MaterialComponents.Button.TextButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:text="Admin"
    android:textColor="#4D4D4D"
    android:textSize="12sp"
    app:icon="@drawable/baseline_settings_24"
    app:iconTint="#4D4D4D"
    android:layout_marginBottom="16dp"/>

    <!-- El texto real lo pone MenuRolesActivity desde BuildConfig.VERSION_NAME (onCreate).
         Con tools:text el número solo existe en el preview y no puede quedar viejo. -->
    <TextView
        android:id="@+id/textViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="DETCUADOR S.A. | John Garcia | Versión 0.0.0"
        android:textColor="#888888"
        android:textSize="14sp" />

</LinearLayout>
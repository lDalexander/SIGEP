<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F0F0F0">

    <TextView
        android:id="@+id/tvTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acceso Restringido"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccione su Usuario:"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerUsuariosLogin"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN de Seguridad:"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingrese su PIN de seguridad de 4 dígitos"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/etPinAcceso"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textSize="32sp"
        android:letterSpacing="0.5"
        android:background="#FFFFFF"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="INGRESAR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"/>

</LinearLayout>
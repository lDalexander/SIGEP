<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNombreMaquina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Máquina 7B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/tvEstadoMaquina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="ACTIVA"
                android:textStyle="bold"
                android:textColor="#22C55E" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <TextView
                android:id="@+id/tvOperadorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Operador: "
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNombreOperador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juan Garcia" />

            <TextView
                android:id="@+id/tvProductoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Producto: "
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDetalleProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detergente 1000ml"
                android:layout_marginTop="4dp" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Inicio Turno"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/tvHoraInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:30 AM"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Pacas"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/tvTotalPacas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="145"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#3B82F6" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
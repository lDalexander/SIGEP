<?xml version="1.0" encoding="utf-8"?>
<!-- Mensaje recibido: a la izquierda, en blanco. El nombre solo se muestra en los
     avisos generales, donde pueden escribir varios supervisores. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="56dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_burbuja_ajena"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tvAutorBurbuja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Planta"
            android:textColor="#0E7490"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTextoBurbuja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje"
            android:textColor="#0F172A"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvHoraBurbuja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="10:42"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

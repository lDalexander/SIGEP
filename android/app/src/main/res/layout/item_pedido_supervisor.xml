<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvIdPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1234"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tvStatusPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="ENTREGADO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#DCFCE7"
                android:textColor="#166534" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvDetallePedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lámina (Rollo) x 2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvOrigenDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitado por: Máquina 7B"
            android:textSize="13sp"
            android:textColor="#475569" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginVertical="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atendido por:"
                android:textSize="12sp"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/tvAtendidoPor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insumista Pedro"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiempo Resp:"
                android:textSize="12sp"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/tvTiempoRespuesta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 min"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </GridLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
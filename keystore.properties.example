# Plantilla para la firma del APK de release.
#
# COPIA este archivo como `keystore.properties` (en la raíz del proyecto) y rellena
# tus valores reales. NUNCA subas keystore.properties ni el .jks al repositorio:
# ambos están en .gitignore.
#
# storeFile puede ser una ruta absoluta o relativa a la raíz del proyecto.

storeFile=sigep-release.jks
storePassword=CAMBIA_ESTA_CLAVE
keyAlias=sigep
keyPassword=CAMBIA_ESTA_CLAVE
